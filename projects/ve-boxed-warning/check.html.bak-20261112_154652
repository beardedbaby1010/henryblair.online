 --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;--sans:Inter,system-ui,sans-serif}
@media (prefers-color-scheme:dark){:root{--bg:#101318;--panel:#171b22;--ink:#e9edf3;
