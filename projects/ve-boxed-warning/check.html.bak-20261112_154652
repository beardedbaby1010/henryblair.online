</style>
<div class="wrap" style="max-width:1200px">
<header><h1>VE Query Logic Check</h1>
<p class="sub">Reads a sheet tab live through the gviz CSV endpoint and checks every
BCa query's group structure against the spec its name implies.</p></header>
<div class="card">
 <div class="row">
  <div><label for="key">Sheet URL or key</label>
   <input id="key" value="1Cy64AGkUWwHMHl3a-F2AhOxZOmTl-iOJMsmy5FA85L8" spellcheck="false"></div>
  <div><label for="tab">Tab name</label><input id="tab" value="Old_BCa_Data" spellcheck="false"></div>
  <button id="run">Check</button>
 </div>
 <p class="note" style="margin:10px 0 0">The sheet must be viewable by anyone with the
 link, the same requirement your other live figures have.</p>
</div>
<div id="out"></div>
</div>
<script>
const COH=["No_HA","No_C50","No_Hx","HA","C50","Hx","Unstrat"];
const STR=["ERPos","ERNeg","ERAmbig","ERUnrec","ERP_Old","ERN_Old"];
const MARK=[["ICD","Diagnoses: ICD-10"],["CPT","CPT 1013626"],["VAG","estradiol"],
  ["C50","ICD-10-CM C50"],["Z85","Z85.3"],["Z170","Z17.0"],["Z171","Z17.1"],["ET","tamoxifen"]];
const FP={In_Care:"11000000/00000000/OR",VE_Denom:"11000000/00000000/OR",
  WASHOUT_VE:"00000000/00100000/-",VE_Num:"00100000/00000000/-",
  HA:"00011000/00000000/OR",C50:"00010000/00000000/-",Hx:"00001000/00000000/-",
  No_HA:"00000000/00011000/OR",No_C50:"00000000/00010000/-",No_Hx:"00000000/00001000/-",
  ERPos:"00000101/00000010/OR",ERNeg:"00000010/00000101/OR",ERAmbig:"00000110/00000000/AND",
  ERUnrec:"00000000/00000110/OR",ERP_Old:"00000100/00000010/-",ERN_Old:"00000010/00000100/-"};
const HUMAN={In_Care:"must: ICD-10 dx OR CPT 1013626 office visit",
  VE_Denom:"must: ICD-10 dx OR CPT 1013626 office visit",
  WASHOUT_VE:"cannot: estradiol [Vaginal Product]",
  VE_Num:"must: estradiol [Vaginal Product]",
  HA:"must: C50 OR Z85.3",C50:"must: C50",Hx:"must: Z85.3",
  No_HA:"cannot: C50 OR Z85.3",No_C50:"cannot: C50",No_Hx:"cannot: Z85.3",
  ERPos:"must: Z17.0 OR tamoxifen OR anastrozole OR letrozole OR exemestane · cannot: Z17.1",
  ERNeg:"must: Z17.1 · cannot: Z17.0 OR the four endocrine agents",
  ERAmbig:"must: Z17.1 AND Z17.0",ERUnrec:"cannot: Z17.1 OR Z17.0",
  ERP_Old:"must: Z17.0 · cannot: Z17.1",ERN_Old:"must: Z17.1 · cannot: Z17.0"};

const NAME_RE=new RegExp("^BCa-("+COH.join("|")+")_∩_(?:("+STR.join("|")+")_)?((?:prev_)?(?:num|denom))_(2[45])_(Nov|Jun)$");
function parseName(n){const m=NAME_RE.exec(n.trim());if(!m)return null;
  return{cohort:m[1],stratum:m[2]||"",metric:m[3],yy:m[4],mon:m[5]};}
function windows(yy,mon){const y=+yy;
  if(mon==="Nov")return{idx:`between Nov 01, 20${y} and Mar 31, 20${y+1}`,
    care:`between Nov 01, 20${y-1} and Mar 31, 20${y}`,cut:`on or before Oct 31, 20${y}`};
  return{idx:`between Jun 01, 20${y} and Oct 31, 20${y}`,
    care:`between Jun 01, 20${y-1} and Oct 31, 20${y-1}`,cut:`on or before May 31, 20${y}`};}
function expected(name){const p=parseName(name);if(!p)return null;
  const w=windows(p.yy,p.mon),prev=p.metric.startsWith("prev_"),num=p.metric.endsWith("num");
  const out=[["In_Care",w.care]];
  if(!prev)out.push(["WASHOUT_VE",w.cut]);
  out.push(["VE_Denom",w.idx]);
  if(p.cohort!=="Unstrat")out.push([p.cohort,w.cut]);
  if(num)out.push(["VE_Num",w.idx]);
  if(p.stratum)out.push([p.stratum,w.cut]);
  return out.map(([t,win])=>({title:t,fp:FP[t],win,human:HUMAN[t]}));}

function clean(s){s=String(s);if(!s.startsWith("="))return s;
  s=s.replace(/^=/,"").replace(/^"|"$/g,"");
  s=s.split('"&CHAR(10)&"').join("\n").split("&CHAR(10)&").join("\n");
  // rows pasted without their CHAR(10)s arrive as bare &"-concatenation;
  // that join is the line break too.
  return s.split('"&"').join("\n").split('""').join('"');}
function fingerprint(cell){
  const mm=/Must have:([\s\S]*?)(?:Cannot have:|$)/.exec(cell),
        cc=/Cannot have:([\s\S]*)/.exec(cell);
  const bits=m=>{const b=m?m[1]:"";return MARK.map(k=>b.includes(k[1])?"1":"0").join("");};
  // multiline cells start a line with the operator; gviz-flattened cells
  // put it straight after the previous term's ")".
  const op=/(?:^|\n|\))\s*AND /.test(cell)?"AND"
          :(/(?:^|\n|\))\s*OR /.test(cell)?"OR":"-");
  return bits(mm)+"/"+bits(cc)+"/"+op;}
const TITLES=new Set(Object.keys(FP));
const JOIN=/^\d+(?: (?:AND|OR) \d+)+$/;
function actual(cells){
  // Column layout is not fixed - tabs differ in whether the =$A$n helper
  // columns are present - so find group cells by content, not by stride.
  const c=cells.map(x=>clean(x).trim()),gs=[];
  // A dump ends at its own join marker ("1 AND 2 AND 3"). Anything past that
  // is residue from an earlier, wider dump that was never cleared, so it is
  // not part of this query.
  let end=c.length;
  for(let i=0;i<c.length;i++){if(JOIN.test(c[i])){end=i;break;}}
  for(let i=0;i<end;i++){
    const cell=c[i];
    if(!cell||cell==="–"||cell==="-")continue;
    const tm=/^\s*"([^"\n]+)"/.exec(cell);
    if(!tm)continue;
    const title=tm[1].trim();
    if(!TITLES.has(title))continue;
    if(!cell.includes("Must have")&&!cell.includes("Cannot have"))continue;
    let win="";
    for(let j=i+1;j<Math.min(i+4,c.length);j++){
      const m=/occurred ((?:between [A-Z][a-z]{2} \d{1,2}, \d{4} and [A-Z][a-z]{2} \d{1,2}, \d{4})|(?:on or (?:before|after) [A-Z][a-z]{2} \d{1,2}, \d{4}))/.exec(c[j]);
      if(m){win=m[1].trim();break;}}
    gs.push({title,fp:fingerprint(cell),win});}
  return gs;}
// The sheet writes "N vs N+1: AND" beside the last group it dumped; when that
// line names a group the dump does not contain, the dump stopped early - the
// query itself still has that group.
function announcesMore(cells,n){
  if(!n)return false;
  const want=n+" vs "+(n+1)+": ";
  return cells.some(x=>{const t=clean(x);
    const i=t.indexOf(want);return i>=0&&/^(AND|OR)\b/.test(t.slice(i+want.length).trim());});}
function kindOf(probs,trunc){
  if(trunc)return "dump truncated";
  if(probs.some(p=>/ titled /.test(p)))return "groups out of order";
  if(probs.some(p=>/: window /.test(p)))return "wrong window";
  if(probs.some(p=>/wrong (?:must-have|cannot-have|AND)/.test(p)))return "wrong terms";
  if(probs.some(p=>/missing:|unexpected:|groups, expected/.test(p)))return "wrong group count";
  return "other";}
function check(cells){
  const name=clean(cells[0]).trim(),exp=expected(name);
  if(!exp)return{name,status:"skip",kind:"not in grammar",problems:["name is not in the BCa grammar"]};
  const act=actual(cells),probs=[];
  if(act.length!==exp.length)
    probs.push(`${act.length} groups, expected ${exp.length} (${exp.map(e=>e.title).join(" → ")})`);
  for(let i=0;i<Math.max(act.length,exp.length);i++){
    const e=exp[i],a=act[i];
    if(e&&!a){probs.push(`group ${i+1} missing: ${e.title}`);continue;}
    if(a&&!e){probs.push(`group ${i+1} unexpected: ${a.title}`);continue;}
    if(a.title!==e.title){probs.push(`group ${i+1} titled ${a.title}, expected ${e.title}`);continue;}
    if(a.fp!==e.fp){const A=a.fp.split("/"),E=e.fp.split("/"),why=[];
      if(A[0]!==E[0])why.push("must-have terms");
      if(A[1]!==E[1])why.push("cannot-have terms");
      if(A[2]!==E[2])why.push(`AND/OR (${A[2]} not ${E[2]})`);
      probs.push(`${e.title}: wrong ${why.join(" and ")}`);}
    if(a.win!==e.win)probs.push(`${e.title}: window “${a.win}”, expected “${e.win}”`);}
  const trunc=act.length<exp.length&&announcesMore(cells,act.length);
  const p=parseName(name);
  return{name,status:probs.length?"bad":"ok",problems:probs,
    kind:probs.length?kindOf(probs,trunc):"",
    cohort:p.cohort,stratum:p.stratum||"(none)",metric:p.metric,window:p.yy+"_"+p.mon};}


const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
function parseCSV(t){const rows=[];let row=[],f="",q=false;
  for(let i=0;i<t.length;i++){const c=t[i];
    if(q){ if(c==='"'){ if(t[i+1]==='"'){f+='"';i++;} else q=false; } else f+=c; }
    else if(c==='"')q=true;
    else if(c===","){row.push(f);f="";}
    else if(c==="\n"){row.push(f);f="";rows.push(row);row=[];}
    else if(c!=="\r")f+=c;}
  if(f.length||row.length){row.push(f);rows.push(row);}
  return rows;}
function keyOf(s){const m=/\/spreadsheets\/d\/([A-Za-z0-9_-]+)/.exec(s);return m?m[1]:s.trim();}
let STATE=null;

const ORDER=["dump truncated","groups out of order","wrong window","wrong terms",
             "wrong group count","other","not in grammar"];

function render(){
  const out=document.getElementById("out"),S=STATE;
  if(!S)return;
  const q=S.q.trim().toLowerCase();
  let rows=S.res.filter(r=>{
    if(S.filter==="bad"&&r.status!=="bad")return false;
    if(S.filter==="ok"&&r.status!=="ok")return false;
    if(S.filter==="skip"&&r.status!=="skip")return false;
    if(S.kind&&r.kind!==S.kind)return false;
    if(q&&!(r.name.toLowerCase().includes(q)||
            (r.problems||[]).join(" ").toLowerCase().includes(q)))return false;
    return true;});

  const cmp={
    row:(a,b)=>a.i-b.i,
    name:(a,b)=>a.name.localeCompare(b.name),
    kind:(a,b)=>(ORDER.indexOf(a.kind)-ORDER.indexOf(b.kind))||a.i-b.i,
    cohort:(a,b)=>(a.cohort||"").localeCompare(b.cohort||"")||a.i-b.i,
    window:(a,b)=>(a.window||"").localeCompare(b.window||"")||a.i-b.i};
  rows=rows.slice().sort(cmp[S.sort]||cmp.row);
  if(S.desc)rows.reverse();

  const tile=(n,lab,col,key)=>'<button class="tile'+(S.filter===key?" on":"")+'" data-f="'+key+'">'
    +'<b'+(col?' style="color:var(--'+col+')"':'')+'>'+n+'</b><span>'+lab+'</span></button>';

  const kinds={};
  for(const r of S.res)if(r.kind)kinds[r.kind]=(kinds[r.kind]||0)+1;
  const chips=ORDER.filter(k=>kinds[k]).map(k=>
    '<button class="chip'+(S.kind===k?" on":"")+'" data-k="'+k+'">'+k
    +' <i>'+kinds[k]+'</i></button>').join("");

  const th=(key,lab)=>'<th class="sort'+(S.sort===key?" on":"")+'" data-s="'+key+'">'+lab
    +(S.sort===key?(S.desc?" \u25be":" \u25b4"):"")+'</th>';

  let body="";
  if(!rows.length)body='<p class="note">Nothing matches that filter.</p>';
  else if(S.group==="none"){
    body='<div class="scroll"><table><thead><tr><th></th>'
      +th("row","Row")+th("name","Query")+th("kind","Problem")
      +'<th>What\u2019s wrong</th></tr></thead><tbody>'
      +rows.map(tr).join("")+'</tbody></table></div>';
  }else{
    const buckets=new Map();
    for(const r of rows){const k=r[S.group]||"(none)";
      if(!buckets.has(k))buckets.set(k,[]);buckets.get(k).push(r);}
    const keys=[...buckets.keys()].sort((a,b)=>
      S.group==="kind"?ORDER.indexOf(a)-ORDER.indexOf(b):a.localeCompare(b));
    body=keys.map(k=>{const g=buckets.get(k),
      nb=g.filter(r=>r.status==="bad").length,nk=g.filter(r=>r.status==="skip").length,
      no=g.filter(r=>r.status==="ok").length;
      return '<details open><summary><span class="gk">'+esc(k)+'</span>'
       +'<span class="gc">'+g.length+' row'+(g.length===1?"":"s")
       +(no?' \u00b7 <em class="ok">'+no+' pass</em>':"")
       +(nb?' \u00b7 <em class="bad">'+nb+' fail</em>':"")
       +(nk?' \u00b7 <em class="warn">'+nk+' not in grammar</em>':"")+'</span></summary>'
       +'<div class="scroll"><table><tbody>'+g.map(tr).join("")+'</tbody></table></div></details>';
    }).join("");
  }

  out.innerHTML='<div class="card">'
    +'<div class="tally">'
    +tile(S.res.length,"rows","","all")
    +tile(S.n.ok,"pass","ok","ok")
    +tile(S.n.bad,"fail","bad","bad")
    +tile(S.n.skip,"name not in grammar","warn","skip")
    +'</div>'
    +(chips?'<div class="chips"><span class="clab">Problem</span>'+chips
      +(S.kind?'<button class="chip clear" data-k="">clear</button>':"")+'</div>':"")
    +'<div class="bar">'
    +'<label class="inl">Group by '
      +'<select id="grp">'+[["none","nothing"],["kind","problem"],["window","window"],
         ["cohort","cohort"],["stratum","stratum"],["metric","metric"]]
        .map(([v,l])=>'<option value="'+v+'"'+(S.group===v?" selected":"")+'>'+l+'</option>').join("")
      +'</select></label>'
    +'<input id="q" placeholder="filter by name or problem\u2026" value="'+esc(S.q)+'">'
    +'<span class="note">'+rows.length+' shown</span>'
    +'</div>'+body+'</div>';

  out.querySelectorAll(".tile").forEach(b=>b.onclick=()=>{
    S.filter=(S.filter===b.dataset.f?"all":b.dataset.f);render();});
  out.querySelectorAll(".chip").forEach(b=>b.onclick=()=>{
    S.kind=(S.kind===b.dataset.k?"":b.dataset.k);render();});
  out.querySelectorAll("th.sort").forEach(h=>h.onclick=()=>{
    const k=h.dataset.s;if(S.sort===k)S.desc=!S.desc;else{S.sort=k;S.desc=false;}render();});
  const g=out.querySelector("#grp");if(g)g.onchange=()=>{S.group=g.value;render();};
  const qi=out.querySelector("#q");
  if(qi)qi.oninput=()=>{S.q=qi.value;const p=qi.selectionStart;render();
    const n=document.getElementById("q");if(n){n.focus();n.setSelectionRange(p,p);}};
}
function tr(r){
  const m=r.status==="ok"?["ok","\u2713"]:r.status==="bad"?["bad","\u2717"]:["warn","\u2014"];
  return '<tr><td><span class="mark '+m[0]+'">'+m[1]+'</span></td>'
   +'<td class="num">'+r.i+'</td>'
   +'<td class="g">'+esc(r.name)+'</td>'
   +'<td class="kind">'+esc(r.kind||"")+'</td>'
   +'<td class="why">'+esc((r.problems||[]).join("; "))+'</td></tr>';}

function keyOf2(){}
async function run(){
  const out=document.getElementById("out");
  const key=keyOf(document.getElementById("key").value),
        tab=document.getElementById("tab").value.trim();
  out.innerHTML='<div class="card"><p class="note">Loading '+esc(tab)+'\u2026</p></div>';
  const url="https://docs.google.com/spreadsheets/d/"+encodeURIComponent(key)
    +"/gviz/tq?tqx=out:csv&headers=0&sheet="+encodeURIComponent(tab);
  let text;
  try{const r=await fetch(url);
    if(!r.ok)throw new Error("HTTP "+r.status+(r.status===404?" \u2014 no tab by that name":""));
    text=await r.text();}
  catch(e){out.innerHTML='<div class="card"><p class="err">Could not read the sheet: '
    +esc(e.message)+'. Check the tab name, and that the sheet is shared to anyone with the link.</p></div>';return;}
  if(/^\s*<!DOCTYPE/i.test(text)){out.innerHTML='<div class="card"><p class="err">'
    +'Google returned a sign-in page instead of CSV \u2014 the sheet is not link-viewable.</p></div>';return;}
  const all=parseCSV(text);
  const res=[];
  all.forEach((row,ix)=>{ if(!row.length||!String(row[0]).trim())return;
    const v=check(row); v.i=ix+1; res.push(v); });
  const n={ok:res.filter(r=>r.status==="ok").length,
           bad:res.filter(r=>r.status==="bad").length,
           skip:res.filter(r=>r.status==="skip").length};
  STATE={res,n,filter:"bad",kind:"",group:"kind",sort:"row",desc:false,q:""};
  render();}
document.getElementById("run").addEventListener("click",run);
</script>
