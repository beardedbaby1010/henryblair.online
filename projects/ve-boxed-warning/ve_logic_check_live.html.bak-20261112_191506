<div class="wrap" style="max-width:1200px">
<header><h1>VE Query Logic Check</h1>
<p class="sub">Reads a sheet tab live through the gviz CSV endpoint and checks every
BCa query's group structure against the spec its name implies.</p></header>
<div class="card">
 <div class="row">
  <div><label for="key">Sheet URL or key</label>
   <input id="key" value="1Cy64AGkUWwHMHl3a-F2AhOxZOmTl-iOJMsmy5FA85L8" spellcheck="false"></div>
  <div><label for="tab">Tab name</label><input id="tab" value="Old_BCa_Data" spellcheck="false"></div>
  <button id="run">Check</button>
 </div>
 <p class="note" style="margin:10px 0 0">The sheet must be viewable by anyone with the
 link, the same requirement your other live figures have.</p>
</div>
<div id="out"></div>
</div>
<script>
const COH=["No_HA","No_C50","No_Hx","HA","C50","Hx","Unstrat"];
const STR=["ERPos","ERNeg","ERAmbig","ERUnrec","ERP_Old","ERN_Old"];
const MARK=[["ICD","Diagnoses: ICD-10"],["CPT","CPT 1013626"],["VAG","estradiol"],
  ["C50","ICD-10-CM C50"],["Z85","Z85.3"],["Z170","Z17.0"],["Z171","Z17.1"],["ET","tamoxifen"]];
const FP={In_Care:"11000000/00000000/OR",VE_Denom:"11000000/00000000/OR",
  WASHOUT_VE:"00000000/00100000/-",VE_Num:"00100000/00000000/-",
  HA:"00011000/00000000/OR",C50:"00010000/00000000/-",Hx:"00001000/00000000/-",
  No_HA:"00000000/00011000/OR",No_C50:"00000000/00010000/-",No_Hx:"00000000/00001000/-",
  ERPos:"00000101/00000010/OR",ERNeg:"00000010/00000101/OR",ERAmbig:"00000110/00000000/AND",
  ERUnrec:"00000000/00000110/OR",ERP_Old:"00000100/00000010/-",ERN_Old:"00000010/00000100/-"};
const HUMAN={In_Care:"must: ICD-10 dx OR CPT 1013626 office visit",
  VE_Denom:"must: ICD-10 dx OR CPT 1013626 office visit",
  WASHOUT_VE:"cannot: estradiol [Vaginal Product]",
  VE_Num:"must: estradiol [Vaginal Product]",
  HA:"must: C50 OR Z85.3",C50:"must: C50",Hx:"must: Z85.3",
  No_HA:"cannot: C50 OR Z85.3",No_C50:"cannot: C50",No_Hx:"cannot: Z85.3",
  ERPos:"must: Z17.0 OR tamoxifen OR anastrozole OR letrozole OR exemestane · cannot: Z17.1",
  ERNeg:"must: Z17.1 · cannot: Z17.0 OR the four endocrine agents",
  ERAmbig:"must: Z17.1 AND Z17.0",ERUnrec:"cannot: Z17.1 OR Z17.0",
  ERP_Old:"must: Z17.0 · cannot: Z17.1",ERN_Old:"must: Z17.1 · cannot: Z17.0"};

const NAME_RE=new RegExp("^BCa-("+COH.join("|")+")_∩_(?:("+STR.join("|")+")_)?((?:prev_)?(?:num|denom))_(2[45])_(Nov|Jun)$");
function parseName(n){const m=NAME_RE.exec(n.trim());if(!m)return null;
  return{cohort:m[1],stratum:m[2]||"",metric:m[3],yy:m[4],mon:m[5]};}
function windows(yy,mon){const y=+yy;
  if(mon==="Nov")return{idx:`between Nov 01, 20${y} and Mar 31, 20${y+1}`,
    care:`between Nov 01, 20${y-1} and Mar 31, 20${y}`,cut:`on or before Oct 31, 20${y}`};
  return{idx:`between Jun 01, 20${y} and Oct 31, 20${y}`,
    care:`between Jun 01, 20${y-1} and Oct 31, 20${y-1}`,cut:`on or before May 31, 20${y}`};}
function expected(name){const p=parseName(name);if(!p)return null;
  const w=windows(p.yy,p.mon),prev=p.metric.startsWith("prev_"),num=p.metric.endsWith("num");
  const out=[["In_Care",w.care]];
  if(!prev)out.push(["WASHOUT_VE",w.cut]);
  out.push(["VE_Denom",w.idx]);
  if(p.cohort!=="Unstrat")out.push([p.cohort,w.cut]);
  if(num)out.push(["VE_Num",w.idx]);
  if(p.stratum)out.push([p.stratum,w.cut]);
  return out.map(([t,win])=>({title:t,fp:FP[t],win,human:HUMAN[t]}));}

function clean(s){s=String(s);if(!s.startsWith("="))return s;
  s=s.replace(/^=/,"").replace(/^"|"$/g,"");
  s=s.split('"&CHAR(10)&"').join("\n").split("&CHAR(10)&").join("\n");
  // rows pasted without their CHAR(10)s arrive as bare &"-concatenation;
  // that join is the line break too.
  return s.split('"&"').join("\n").split('""').join('"');}
function fingerprint(cell){
  const mm=/Must have:([\s\S]*?)(?:Cannot have:|$)/.exec(cell),
        cc=/Cannot have:([\s\S]*)/.exec(cell);
  const bits=m=>{const b=m?m[1]:"";return MARK.map(k=>b.includes(k[1])?"1":"0").join("");};
  // multiline cells start a line with the operator; gviz-flattened cells
  // put it straight after the previous term's ")".
  const op=/(?:^|\n|\))\s*AND /.test(cell)?"AND"
          :(/(?:^|\n|\))\s*OR /.test(cell)?"OR":"-");
  return bits(mm)+"/"+bits(cc)+"/"+op;}
const TITLES=new Set(Object.keys(FP));
const JOIN=/^\d+(?: (?:AND|OR) \d+)+$/;
function actual(cells){
