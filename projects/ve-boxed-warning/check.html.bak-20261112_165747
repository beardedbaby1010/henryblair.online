/* ---------------------------------------------------------------------------
   FIGURES.  Three jobs, three forms:
     A  share of each failure kind  -> one proportional segmented bar
                                       (the kinds partition the fails, so a
                                        part-to-whole bar is honest; a Venn is
                                        not - see B for the real overlap)
     B  defect co-occurrence        -> UpSet-style bar. A row can be wrong on
                                       several axes at once; this is the figure
                                       a Venn would be trying to be, without a
                                       Venn's 3-set ceiling or unreadable lobes.
     C  which families fail         -> small multiples, fail RATE not fail count,
                                       because the families are different sizes.
   Every bar is clickable and drives the same filter state as the chips.
--------------------------------------------------------------------------- */
const PAL=["#2a78d6","#eb6834","#1baf7a","#eda100","#e87ba4","#6250d6"];
const PALD=["#3987e5","#d95926","#199e70","#c98500","#d55181","#9085e9"];
function pal(i){return (document.documentElement.dataset.theme==="dark"||
  (window.matchMedia&&matchMedia("(prefers-color-scheme:dark)").matches&&
   document.documentElement.dataset.theme!=="light"))?PALD[i%6]:PAL[i%6];}
const KCOL={}; ORDER.forEach((k,i)=>KCOL[k]=i);

function segbar(rows,total,attr){      // [[label,n,colorIdx,key]], attr = data-<attr>
  if(!total)return "";
  const A=attr||"k";
  const W=100, gap=0.35;
  let x=0,seg="",leg="";
  rows.forEach(([lab,n,ci,key])=>{
    const w=Math.max(0,(n/total)*W-gap);
    seg+=`<rect class="hit" data-${A}="${esc(key)}" x="${x.toFixed(3)}%" y="0" width="${w.toFixed(3)}%" height="26" rx="3" fill="${pal(ci)}"><title>${esc(lab)}: ${n} (${Math.round(n/total*100)}%)</title></rect>`;
    x+=(n/total)*W;
    leg+=`<button class="lg hit" data-${A}="${esc(key)}"><i style="background:${pal(ci)}"></i>${esc(lab)} <b>${n}</b> <em>${Math.round(n/total*100)}%</em></button>`;
  });
  return `<svg class="sb" viewBox="0 0 100 26" preserveAspectRatio="none" height="26">${seg}</svg><div class="lgs">${leg}</div>`;
}

function hbars(items,opts){ // [[label,value,denom|null,key]]
  const o=opts||{}, max=Math.max(1,...items.map(i=>o.rate?(i[2]?i[1]/i[2]:0):i[1]));
  // one label width for the whole block: the bars then start on a common x,
  // which is the only way a row of small multiples reads as one figure.
  return '<div class="hb"'+(o.lw?' style="--hbl:'+o.lw+'"':'')+'>'+items.map(([lab,v,den,key],i)=>{
    const val=o.rate?(den?v/den:0):v, w=(val/max)*100;
    const txt=o.rate?`${Math.round(val*100)}%  <em>${v}/${den}</em>`:`${v}`;
    return `<div class="hbr hit" data-q="${esc(key||'')}"><span class="hbl">${esc(lab)}</span>`
      +`<span class="hbt"><i style="width:${w.toFixed(1)}%;background:${pal(o.ci||0)}"></i></span>`
      +`<span class="hbv">${txt}</span></div>`;}).join("")+'</div>';
}

function renderViz(S){
  const fails=S.res.filter(r=>r.status==="bad");
  if(!fails.length)return "";
  S.regionSet=["truncated","order","window","terms","count"];

  // A — share of each failure kind
  const kc={}; fails.forEach(r=>kc[r.kind]=(kc[r.kind]||0)+1);
  const arows=ORDER.filter(k=>kc[k]).map(k=>[k,kc[k],KCOL[k],k]);

  // B — co-occurrence of defect axes
  const AX=["truncated","order","window","terms","count"];
  const per={}; AX.forEach(a=>per[a]=0);
  const combo={};
  fails.forEach(r=>{const a=(r.axes||[]).slice().sort((x,y)=>AX.indexOf(x)-AX.indexOf(y));
    a.forEach(x=>per[x]++);
    const k=a.join(" + ")||"(none)"; combo[k]=(combo[k]||0)+1;});
  const crows=Object.entries(combo).sort((a,b)=>b[1]-a[1]).slice(0,10)
    .map(([k,n])=>[k,n,fails.length,""]);
  const prows=AX.filter(a=>per[a]).map(a=>[a,per[a],fails.length,""]);
  const top3=AX.filter(a=>per[a]).sort((a,b)=>per[b]-per[a]).slice(0,3);

  // C — families: fail RATE, since the families differ in size
  const dims=[["window","Window"],["cohort","Cohort"],["stratum","Stratum"],["metric","Metric"]];
  const fam=dims.map(([d,lab])=>{
    const tot={},bad={};
    S.res.forEach(r=>{if(r.status==="skip")return;const k=r[d]||"(none)";
      tot[k]=(tot[k]||0)+1; if(r.status==="bad")bad[k]=(bad[k]||0)+1;});
    const items=Object.keys(tot).map(k=>[k,bad[k]||0,tot[k],k])
      .sort((a,b)=>(b[1]/b[2])-(a[1]/a[2]));
    return `<div class="fx"><h4>${lab}</h4>${hbars(items,{rate:true,ci:2,lw:"11ch"})}</div>`;
  }).join("");

  return '<div class="viz">'
    +`<section><h3>Share of each failure kind</h3>`
    +`<p class="vn">${fails.length} failing quer${fails.length===1?"y":"ies"}. Each row is counted once, under its headline defect.</p>`
    +segbar(arows,fails.length)+`</section>`
    +`<section><h3>How the defects co-occur</h3>`
    +`<p class="vn">A row can be wrong on several axes at once. The Venn takes the three commonest axes \u2014 three circles is as far as one can be read honestly — and the bars carry the rest. Click a region or a bar to filter the table to it.</p>`
    +`<div class="vn2"><div>${top3.length>1?venn3(fails,top3,S):'<p class="vn">Only one defect axis is present, so there is nothing to overlap.</p>'}</div>`
    +`<div><h4>Axis involved in</h4>${hbars(prows,{rate:true,ci:0,lw:"13ch"})}`
    +`<h4 style="margin-top:14px">Exact combination</h4>${hbars(crows,{rate:true,ci:5,lw:"22ch"})}</div></div></section>`
    +`<section><h3>Which families fail</h3>`
    +`<p class="vn">Fail rate, not fail count — the families are different sizes, so counts would just rank them by how many queries they have. Denominator excludes names outside the grammar.</p>`
    +`<div class="fxs">${fam}</div></section>`
    +'</div>';
}

const fmt=n=>n==null?"\u2014":Number(n).toLocaleString("en-US");

/* ---------------------------------------------------------------------------
   SNAPSHOT PROVENANCE.  Every dumped row carries the network total and the
   "N of M" HCO coverage that were on screen when that query was read. Those
   are not a property of the query - they date the dump. A table whose rows
   were read against different network totals has no single denominator, which
   is exactly the thing a reviewer will ask about, so it gets its own section.
   Column layout is not fixed, so find the pair by content: the "N of M" cell,
   and the nearest 6-10 digit integer before it.
--------------------------------------------------------------------------- */
function snapOf(cells){
  // the same cell arrives three ways depending on how the tab was built:
  // gviz display text (79 of 79), a pasted formula (="79 of 79"), or an
  // on-disk dump row where the literal quotes survive. Strip them first.
  const c=cells.map(x=>clean(x).trim().replace(/^"+|"+$/g,"").trim());
  let hi=-1,m=null;
  for(let i=1;i<c.length;i++){const t=/^(\d+)\s+of\s+(\d+)$/.exec(c[i]);
    if(t){hi=i;m=t;break;}}
  if(hi<0)return null;
  const num=s=>{const v=String(s).replace(/,/g,"");return /^\d+$/.test(v)?+v:null;};
  let net=null;
  for(let j=hi-1;j>=1;j--){const v=num(c[j]);if(v!==null&&v>=100000){net=v;break;}}
  if(net===null)return null;
  const pre=[];for(let j=1;j<hi;j++){const v=num(c[j]);if(v!==null)pre.push(v);}
  return {net,on:+m[1],of:+m[2],pts:pre.length?pre[0]:null,sites:pre.length>1?pre[1]:null};
}

function renderSnaps(S){
  const rows=S.res.filter(r=>r.snap);
  if(!rows.length)return "";
  const cnt=S.snapCount,keys=S.snapKeys,dom=S.dom;
  const vals=keys.slice().sort((a,b)=>a-b),lo=vals[0],hi=vals[vals.length-1];
  const off=rows.filter(r=>r.off).length, part=rows.filter(r=>!r.full).length;
  const seg=keys.map((k,i)=>[fmt(k),cnt[k],i,String(k)]);
  const tab='<table class="snaptab"><thead><tr><th>Network total</th><th>HCO coverage</th>'
    +'<th style="text-align:right">Rows</th><th style="text-align:right">Share</th>'
    +'<th style="text-align:right">\u0394 vs dominant</th></tr></thead><tbody>'
    +keys.map((k,i)=>{const d=k-dom;
      return '<tr class="hit'+(k===dom?" dom":"")+(S.snap===String(k)?" on":"")+'" data-sk="'+k+'">'
       +'<td class="n"><i class="sw" style="background:'+pal(i)+'"></i>'+fmt(k)+'</td>'
       +'<td class="n">'+esc(S.snapHco[k]||"")
         +(S.snapFull[k]?"":'<span class="flag">partial</span>')+'</td>'
       +'<td class="n" style="text-align:right">'+cnt[k]+'</td>'
       +'<td class="n" style="text-align:right">'+(cnt[k]/rows.length*100).toFixed(1)+'%</td>'
       +'<td class="n" style="text-align:right">'
         +(d?(d>0?"+":"\u2212")+fmt(Math.abs(d)):"\u2014")+'</td></tr>';}).join("")
    +'</tbody></table>';
  const dims=[["window","Window"],["cohort","Cohort"],["stratum","Stratum"],["metric","Metric"]];
  const fam=dims.map(d=>{const tot={},bad={};
    rows.forEach(r=>{const k=r[d[0]]||"(none)";tot[k]=(tot[k]||0)+1;if(r.off)bad[k]=(bad[k]||0)+1;});
    const items=Object.keys(tot).map(k=>[k,bad[k]||0,tot[k],k])
      .sort((a,b)=>(b[1]/b[2])-(a[1]/a[2]));
    return '<div class="fx"><h4>'+d[1]+'</h4>'+hbars(items,{rate:true,ci:3,lw:"11ch"})+'</div>';}).join("");
  return '<div class="viz">'
   +'<section><h3>Snapshot provenance</h3>'
   +'<p class="vn">Each row was read against whatever network total TriNetX happened to be '
   +'showing at that moment, so the figure dates the dump rather than describing the query. '
   +(keys.length>1
      ?'These '+rows.length+' rows are a patchwork of <b>'+keys.length
       +'</b> snapshots, so the table has no single denominator yet.'
      :'All '+rows.length+' rows share one snapshot \u2014 the table has a single denominator.')
   +'</p>'
   +'<div class="kv">'
   +'<div><b'+(keys.length>1?' style="color:var(--warn)"':'')+'>'+keys.length+'</b><span>snapshots</span></div>'
   +'<div><b>'+Math.round(cnt[dom]/rows.length*100)+'%</b><span>on dominant</span></div>'
   +'<div><b'+(off?' style="color:var(--warn)"':'')+'>'+off+'</b><span>rows off it</span></div>'
   +'<div><b>'+fmt(hi-lo)+'</b><span>spread max\u2212min</span></div>'
   +'<div><b'+(part?' style="color:var(--warn)"':'')+'>'+part+'</b><span>below full HCO</span></div>'
   +'<div><b>'+fmt(dom)+'</b><span>dominant n</span></div>'
   +'</div>'
   +segbar(seg,rows.length,"sk")
   +'<div class="scroll" style="margin-top:18px">'+tab+'</div></section>'
   +(off?'<section><h3>Which families sit off the dominant snapshot</h3>'
     +'<p class="vn">Share of each family read against something other than '+fmt(dom)
     +'. A family at 100% was refreshed as one block \u2014 that is a resume boundary in the run, '
     +'not a property of the data. Click a bar to filter the table to it.</p>'
     +'<div class="fxs">'+fam+'</div></section>':"")
   +'</div>';
}

/* ---------------------------------------------------------------------------
   RUN-LOG CORRELATION.  Baked in from 3_VE/Logs at build time; a static page
   cannot read your disk. One question: do the rows that are off-snapshot, or
   failing, share a history of being WRITTEN to (fork / replace_rename /
   shift_dates / remove_group / del / paste) rather than merely read?
--------------------------------------------------------------------------- */
function renderLogs(S){
  if(typeof LOGS==="undefined"||!LOGS||!LOGS.q)return "";
  const Q=LOGS.q,kf=n=>n.replace("BCa-","");
  const mrows=Object.keys(LOGS.modes).map(m=>[m,LOGS.modes[m],LOGS.files,""])
    .sort((a,b)=>b[1]-a[1]);
  const have=S.res.filter(r=>Q[kf(r.name)]).length;
  const top=S.res.map(r=>[r.name,Q[kf(r.name)]]).filter(x=>x[1])
    .sort((a,b)=>b[1][0]-a[1][0]).slice(0,12)
    .map(x=>[kf(x[0]),x[1][0],null,x[0]]);
  const grp=(sel,lab)=>{const g=S.res.filter(sel).map(r=>Q[kf(r.name)]).filter(Boolean);
    if(!g.length)return null;
    return [lab,g.length,g.reduce((s,v)=>s+v[0],0)/g.length,
            g.reduce((s,v)=>s+v[1],0)/g.length,g.filter(v=>v[1]>0).length/g.length];};
  const cm=[grp(r=>r.snap&&!r.off,"On the dominant snapshot"),
            grp(r=>r.off,"Off the dominant snapshot"),
            grp(r=>r.status==="bad","Failing the logic check"),
            grp(r=>r.status==="skip","Name not in the grammar")].filter(Boolean);
  const ctab='<table class="snaptab"><thead><tr><th>Group</th>'
    +'<th style="text-align:right">Rows</th><th style="text-align:right">Mean touches</th>'
    +'<th style="text-align:right">Mean writes</th>'
    +'<th style="text-align:right">Any write</th></tr></thead><tbody>'
    +cm.map(r=>'<tr><td>'+esc(r[0])+'</td>'
      +'<td class="n" style="text-align:right">'+r[1]+'</td>'
      +'<td class="n" style="text-align:right">'+r[2].toFixed(1)+'</td>'
      +'<td class="n" style="text-align:right">'+r[3].toFixed(2)+'</td>'
      +'<td class="n" style="text-align:right">'+Math.round(r[4]*100)+'%</td></tr>').join("")
    +'</tbody></table>';
  return '<div class="viz">'
   +'<section><h3>What the run logs did to these queries</h3>'
   +'<p class="vn">'+LOGS.files+' run logs, '+esc(LOGS.span)+'. '+have+' of '+S.res.length
   +' rows are named in at least one of them. Counts are name mentions per log, '
   +'so a single long walk can touch one query several times.</p>'
   +'<div class="two"><div><h4>Runs by mode</h4>'+hbars(mrows,{rate:true,ci:4,lw:"15ch"})+'</div>'
   +'<div><h4>Most-touched queries</h4>'+hbars(top,{ci:1,lw:"34ch"})+'</div></div></section>'
   +'<section><h3>Does being written to predict being wrong?</h3>'
   +'<p class="vn">Writes are fork, replace_rename, shift_dates, remove_group, del and paste. '
   +'If the off-snapshot or failing rows carried many more writes than the rest, that would '
   +'point at the code path that produced them. Read it as description: these groups are small, '
   +'and the modes were never applied at random.</p>'
   +'<div class="scroll">'+ctab+'</div></section>'
   +'</div>';
}

/* ---------------------------------------------------------------------------
   A DEVIATION, RENDERED.  What the row actually says is the thing you read
   first, in the fail colour. Hovering strikes it through and slides the
   expected value in beside it, in the pass colour - so the correction never
   occupies space until you ask for it, and the row stays scannable.
--------------------------------------------------------------------------- */
const FLD={must:"must have",cannot:"cannot have",operator:"operator",
           window:"window",title:"titled",group:"group"};
function dv(iss){
  return '<span class="dv"><span class="act">'+esc(iss.act)+'</span>'
    +'<span class="arw">\u2192</span>'
    +'<span class="exp">'+esc(iss.exp)+'</span></span>';}
function devList(r){
  const out=[];
  (r.groups||[]).forEach(g=>{if(!g.issues.length)return;
    g.issues.forEach(iss=>out.push('<span class="dev">'
      // a title/presence defect is about the slot, not the group that is in it,
      // so naming the group there would print the expected name twice
      +'<span class="gid">'+(iss.f==="title"||iss.f==="group"
          ? "group "+g.n : g.n+'\u00b7'+esc(g.title||"?"))+'</span>'
      +'<span class="fld">'+(FLD[iss.f]||iss.f)+'</span>'+dv(iss)+'</span>'));});
  if(!out.length)return esc((r.problems||[]).join("; "));
  return '<span class="devs">'+out.join("")+'</span>';}

/* group tiles for an expanded row: every group the query should have, in order,
   green when it matches and red when it does not. */
function tiles(r){
  if(!r.groups||!r.groups.length)return "";
  const t=r.groups.map(g=>{
    const bad=g.state!=="ok", ghost=g.state==="missing";
    const by={}; (g.issues||[]).forEach(i=>by[i.f]=i);
    const line=(lab,f,val)=>{
      if(by[f])return '<span class="gtl"><b>'+lab+'</b> '+dv(by[f])+'</span>';
      return val?'<span class="gtl"><b>'+lab+'</b> '+esc(val)+'</span>':"";};
    const a=g.act,e=g.exp;
    const fp=(a&&a.fp||"").split("/"),ef=(e&&e.fp||"").split("/");
    return '<div class="gt '+(bad?"bad":"ok")+(ghost?" ghost":"")+'">'
      +'<span class="gth"><b>'+g.n+'</b><span class="gnm">'+esc(g.title||"?")+'</span>'
      +'<span class="gok '+(bad?"bad":"ok")+'">'+(bad?"\u2717":"\u2713")+'</span></span>'
      +(ghost?'<span class="gtl"><b>missing</b> '+dv(by.group)+'</span>'
        :line("must",   "must",    fp[0]?bitLabel(fp[0]):"")
        +line("cannot", "cannot",  fp[1]?bitLabel(fp[1]):"")
        +line("op",     "operator",fp[2]||"")
        +line("window", "window",  a?a.win:""))
      +(g.human?'<span class="gtl" style="opacity:.75">'+esc(g.human)+'</span>':"")
      +'</div>';}).join("");
  return '<div class="gts">'+t+'</div>';}

/* ---------------------------------------------------------------------------
   THE VENN.  Three circles is the honest ceiling, so it takes the three axes
   that actually occur most and says plainly how many failures involve none of
   them. The UpSet bars beside it keep the full picture.
--------------------------------------------------------------------------- */
const AXLAB={truncated:"truncated",order:"out of order",window:"window",
             terms:"terms",count:"group count"};
function venn3(fails,top,S){
  const K=top.length;
  const key=r=>top.filter(a=>(r.axes||[]).includes(a)).join("+");
  const reg={}; let none=0;
  fails.forEach(r=>{const k=key(r); if(!k){none++;return;} reg[k]=(reg[k]||0)+1;});
  const C=[{x:103,y:92},{x:157,y:92},{x:130,y:140}].slice(0,K),R=58;
  const at={}; // region centre for up to 3 sets
  if(K>=1)at[top[0]]={x:84,y:72};
  if(K>=2){at[top[1]]={x:176,y:72};at[top[0]+"+"+top[1]]={x:130,y:76};}
  if(K>=3){at[top[2]]={x:130,y:166};
    at[top[0]+"+"+top[2]]={x:97,y:128};at[top[1]+"+"+top[2]]={x:163,y:128};
    at[top[0]+"+"+top[1]+"+"+top[2]]={x:130,y:112};}
  const circles=C.map((c,i)=>'<circle cx="'+c.x+'" cy="'+c.y+'" r="'+R+'" fill="'+pal(i)
    +'" fill-opacity=".20" stroke="'+pal(i)+'" stroke-width="1.5"/>').join("");
  const nums=Object.keys(at).map(k=>{const n=reg[k]||0,p=at[k];
    return '<g class="rg'+(S.region===k?" on":"")+'" data-rg="'+esc(k)+'">'
      +'<circle cx="'+p.x+'" cy="'+(p.y-5)+'" r="15" fill="transparent"/>'
      +'<text class="cnt'+(n?"":" z")+'" x="'+p.x+'" y="'+p.y+'">'+n+'</text></g>';}).join("");
  // the two upper captions sit over circles whose centres are only 54 apart,
  // so they get nudged outward or they collide.
  const labs=C.map((c,i)=>{const dy=i===2?R+18:-R-9, dx=i===2?0:(i===0?-24:24);
    return '<text class="lab" x="'+(c.x+dx)+'" y="'+(c.y+dy)+'">'
      +esc(AXLAB[top[i]]||top[i])+'</text>';}).join("");
  return '<svg class="venn" viewBox="0 0 260 228" width="100%" height="240" '
    +'role="img" aria-label="overlap of the three commonest defect axes">'
    +circles+labs+nums+'</svg>'
    +(none?'<p class="vn" style="margin:2px 0 0">'+none+' failing row'+(none===1?" involves":"s involve")
      +' none of these three.</p>':"");}

function render(){
  const out=document.getElementById("out"),S=STATE;
  if(!S)return;
  const q=S.q.trim().toLowerCase();
  let rows=S.res.filter(r=>{
    if(S.filter==="bad"&&r.status!=="bad")return false;
    if(S.filter==="ok"&&r.status!=="ok")return false;
    if(S.filter==="skip"&&r.status!=="skip")return false;
    if(S.filter==="off"&&!r.off)return false;
    if(S.snap&&String(r.snap)!==S.snap)return false;
    if(S.kind&&r.kind!==S.kind)return false;
    if(S.region){const AXo=["truncated","order","window","terms","count"];
      const k=AXo.filter(a=>(r.axes||[]).includes(a))
        .filter(a=>S.regionSet.includes(a)).join("+");
      if(k!==S.region)return false;}
    if(q&&!(r.name.toLowerCase().includes(q)||
            (r.problems||[]).join(" ").toLowerCase().includes(q)))return false;
    return true;});

  const cmp={
    row:(a,b)=>a.i-b.i,
    name:(a,b)=>a.name.localeCompare(b.name),
    kind:(a,b)=>(ORDER.indexOf(a.kind)-ORDER.indexOf(b.kind))||a.i-b.i,
    cohort:(a,b)=>(a.cohort||"").localeCompare(b.cohort||"")||a.i-b.i,
    window:(a,b)=>(a.window||"").localeCompare(b.window||"")||a.i-b.i,
    snap:(a,b)=>((a.snap||0)-(b.snap||0))||a.i-b.i};
  rows=rows.slice().sort(cmp[S.sort]||cmp.row);
  if(S.desc)rows.reverse();

  const tile=(n,lab,col,key)=>'<button class="tile'+(S.filter===key?" on":"")+'" data-f="'+key+'">'
    +'<b'+(col?' style="color:var(--'+col+')"':'')+'>'+n+'</b><span>'+lab+'</span></button>';
  // a tile with nothing to filter by - it is a readout, not a control
  const stat=(n,lab,col)=>'<div class="tile stat"><b'+(col?' style="color:var(--'+col+')"':'')
    +'>'+n+'</b><span>'+lab+'</span></div>';

  const kinds={};
  for(const r of S.res)if(r.kind)kinds[r.kind]=(kinds[r.kind]||0)+1;
  const chips=ORDER.filter(k=>kinds[k]).map(k=>
    '<button class="chip'+(S.kind===k?" on":"")+'" data-k="'+k+'">'+k
    +' <i>'+kinds[k]+'</i></button>').join("");

  const th=(key,lab)=>'<th class="sort'+(S.sort===key?" on":"")+'" data-s="'+key+'">'+lab
    +(S.sort===key?(S.desc?" \u25be":" \u25b4"):"")+'</th>';

  let body="";
  if(!rows.length)body='<p class="note">Nothing matches that filter.</p>';
  else if(S.group==="none"){
    body='<div class="scroll"><table><thead><tr><th></th>'
      +th("row","Row")+th("name","Query")+th("snap","Snapshot n")+th("kind","Problem")
      +'<th>What\u2019s wrong</th></tr></thead><tbody>'
      +rows.map(tr).join("")+'</tbody></table></div>';
  }else{
    const buckets=new Map();
    for(const r of rows){const k=r[S.group]||"(none)";
      if(!buckets.has(k))buckets.set(k,[]);buckets.get(k).push(r);}
    const keys=[...buckets.keys()].sort((a,b)=>
      S.group==="kind"?ORDER.indexOf(a)-ORDER.indexOf(b):a.localeCompare(b));
    body=keys.map(k=>{const g=buckets.get(k),
      nb=g.filter(r=>r.status==="bad").length,nk=g.filter(r=>r.status==="skip").length,
      no=g.filter(r=>r.status==="ok").length;
      return '<details open><summary><span class="gk">'+esc(k)+'</span>'
       +'<span class="gc">'+g.length+' row'+(g.length===1?"":"s")
       +(no?' \u00b7 <em class="ok">'+no+' pass</em>':"")
       +(nb?' \u00b7 <em class="bad">'+nb+' fail</em>':"")
       +(nk?' \u00b7 <em class="warn">'+nk+' not in grammar</em>':"")+'</span></summary>'
       +'<div class="scroll"><table><tbody>'+g.map(tr).join("")+'</tbody></table></div></details>';
    }).join("");
  }

  out.innerHTML='<div class="card">'
    +'<div class="tally">'
    +tile(S.res.length,"rows","","all")
    +tile(S.n.ok,"pass","ok","ok")
    +tile(S.n.bad,"fail","bad","bad")
    +tile(S.n.skip,"name not in grammar","warn","skip")
    +(S.nsnap?stat(S.nsnap,"snapshots",S.nsnap>1?"warn":"ok"):"")
    +(S.noff?tile(S.noff,"off dominant n","warn","off"):"")
    +'</div>'
    +renderSnaps(S)
    +renderViz(S)
    +renderLogs(S)
    +(chips?'<div class="chips"><span class="clab">Problem</span>'+chips
      +(S.kind?'<button class="chip clear" data-k="">clear</button>':"")+'</div>':"")
    +(S.snapKeys.length>1?'<div class="chips"><span class="clab">Snapshot</span>'
      +S.snapKeys.map((k,i)=>'<button class="chip'+(S.snap===String(k)?" on":"")+'" data-sk="'+k+'">'
        +'<i class="sw" style="background:'+pal(i)+'"></i>'+fmt(k)
        +' <i>'+S.snapCount[k]+'</i></button>').join("")
      +(S.snap?'<button class="chip clear" data-sk="">clear</button>':"")+'</div>':"")
    +'<div class="bar">'
    +'<label class="inl">Group by '
      +'<select id="grp">'+[["none","nothing"],["kind","problem"],["snapshot","snapshot"],
         ["window","window"],["cohort","cohort"],["stratum","stratum"],["metric","metric"]]
        .map(([v,l])=>'<option value="'+v+'"'+(S.group===v?" selected":"")+'>'+l+'</option>').join("")
      +'</select></label>'
    +'<input id="q" placeholder="filter by name or problem\u2026" value="'+esc(S.q)+'">'
    +'<span class="note">'+rows.length+' shown</span>'
    +'</div>'+body+'</div>';

  out.querySelectorAll(".tile[data-f]").forEach(b=>b.onclick=()=>{
    S.filter=(S.filter===b.dataset.f?"all":b.dataset.f);render();});
  out.querySelectorAll(".hit[data-k]").forEach(b=>b.onclick=()=>{
    const k=b.dataset.k; if(!k)return;
    S.kind=(S.kind===k?"":k); S.filter="bad"; render();});
  out.querySelectorAll(".hbr.hit[data-q]").forEach(b=>b.onclick=()=>{
    const q=b.dataset.q; if(!q)return;
    S.q=(S.q===q?"":q); S.filter="bad"; render();});
  out.querySelectorAll(".chip[data-k]").forEach(b=>b.onclick=()=>{
    S.kind=(S.kind===b.dataset.k?"":b.dataset.k);render();});
  out.querySelectorAll("[data-sk]").forEach(b=>b.onclick=()=>{
    const k=b.dataset.sk;
    S.snap=(S.snap===k?"":k);
    if(S.snap&&S.filter==="off")S.filter="all";
    render();});
  out.querySelectorAll("th.sort").forEach(h=>h.onclick=()=>{
    const k=h.dataset.s;if(S.sort===k)S.desc=!S.desc;else{S.sort=k;S.desc=false;}render();});
  // a failing row opens its group tiles in place; the deviations inside stay
  // in their hover-to-correct form, and the open row shows them unprompted.
  out.querySelectorAll("tr.clk[data-row]").forEach(row=>row.onclick=e=>{
    if(e.target.closest("a"))return;
    const d=out.querySelector('tr.det[data-det="'+row.dataset.row+'"]');
    if(!d)return;
    const open=!d.hidden; d.hidden=open; row.classList.toggle("open",!open);});
  out.querySelectorAll(".venn .rg").forEach(g=>g.onclick=()=>{
    const k=g.dataset.rg;
    S.region=(S.region===k?"":k); S.filter="bad"; render();});
  const g=out.querySelector("#grp");if(g)g.onchange=()=>{S.group=g.value;render();};
  const qi=out.querySelector("#q");
  if(qi)qi.oninput=()=>{S.q=qi.value;const p=qi.selectionStart;render();
    const n=document.getElementById("q");if(n){n.focus();n.setSelectionRange(p,p);}};
}
function tr(r){
  const m=r.status==="ok"?["ok","\u2713"]:r.status==="bad"?["bad","\u2717"]:["warn","\u2014"];
  return '<tr'+(r.status==="bad"?' class="clk" data-row="'+r.i+'"':'')+'><td><span class="mark '+m[0]+'">'+m[1]+'</span></td>'
   +'<td class="num">'+r.i+'</td>'
   +'<td class="g">'+esc(r.name)+'</td>'
   +'<td class="snapc'+(r.off?" off":"")+'" title="'+esc(r.hco||"")+'">'
     +(r.snap?fmt(r.snap):"\u2014")+(r.snap&&!r.full?" \u26a0":"")+'</td>'
   +'<td class="kind">'+esc(r.kind||"")+'</td>'
   +'<td class="why">'+(r.status==="bad"?devList(r):esc((r.problems||[]).join("; ")))
   +'</td></tr>'
   +(r.status==="bad"?'<tr class="det" data-det="'+r.i+'" hidden>'
      +'<td class="tiles" colspan="5">'+tiles(r)+'</td></tr>':"");}

function keyOf2(){}
async function run(){
  const out=document.getElementById("out");
  const key=keyOf(document.getElementById("key").value),
        tab=document.getElementById("tab").value.trim();
  out.innerHTML='<div class="card"><p class="note">Loading '+esc(tab)+'\u2026</p></div>';
  const url="https://docs.google.com/spreadsheets/d/"+encodeURIComponent(key)
    +"/gviz/tq?tqx=out:csv&headers=0&sheet="+encodeURIComponent(tab);
  let text;
  try{const r=await fetch(url);
    if(!r.ok)throw new Error("HTTP "+r.status+(r.status===404?" \u2014 no tab by that name":""));
    text=await r.text();}
  catch(e){out.innerHTML='<div class="card"><p class="err">Could not read the sheet: '
    +esc(e.message)+'. Check the tab name, and that the sheet is shared to anyone with the link.</p></div>';return;}
  if(/^\s*<!DOCTYPE/i.test(text)){out.innerHTML='<div class="card"><p class="err">'
    +'Google returned a sign-in page instead of CSV \u2014 the sheet is not link-viewable.</p></div>';return;}
  const all=parseCSV(text);
  const res=[];
  all.forEach((row,ix)=>{ if(!row.length||!String(row[0]).trim())return;
    const v=check(row); v.i=ix+1;
    const sp=snapOf(row);
    v.snap=sp?sp.net:null; v.hco=sp?sp.on+" of "+sp.of:"";
    v.full=sp?sp.on===sp.of:false; v.pts=sp?sp.pts:null;
    v.snapshot=sp?fmt(sp.net):"(none)";
    res.push(v); });
  const n={ok:res.filter(r=>r.status==="ok").length,
           bad:res.filter(r=>r.status==="bad").length,
           skip:res.filter(r=>r.status==="skip").length};
  // The dominant snapshot is simply the one most rows were read against;
  // everything else is a later partial refresh, and gets flagged.
  const snapCount={},snapHco={},snapFull={};
  res.forEach(r=>{if(!r.snap)return;
    snapCount[r.snap]=(snapCount[r.snap]||0)+1;
    snapHco[r.snap]=r.hco; snapFull[r.snap]=r.full;});
  const snapKeys=Object.keys(snapCount).map(Number)
    .sort((a,b)=>snapCount[b]-snapCount[a]||b-a);
  const dom=snapKeys.length?snapKeys[0]:null;
  res.forEach(r=>r.off=!!(r.snap&&dom&&r.snap!==dom));
  STATE={res,n,filter:n.bad?"bad":"all",kind:"",group:n.bad?"kind":"none",
    sort:"row",desc:false,q:"",snap:"",region:"",
    regionSet:["truncated","order","window","terms","count"],
    snapCount,snapKeys,snapHco,snapFull,dom,
    nsnap:snapKeys.length,noff:res.filter(r=>r.off).length};
  render();}
document.getElementById("run").addEventListener("click",run);
</script>
