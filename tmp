func() {
  read "pre?Enter prefix: "

  for f in ${pre}*.mp4(N); do
    if [[ ! -f "${f%.mp4}.avif" ]]; then
      avif "$f"
    fi
    if [[ ! -f "${f%.mp4}.gif" ]]; then
      gif "$f"
    fi
  done

  for f in ${pre}*.(avif|gif)(N); do mv $f "$pre" && gci -f ${pre}/${f}; done
}
