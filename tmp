func() {
  pre="940e7c-0196efd2-00cf-7d72-9ae1-5e01921d6fde_"
  mkdir -p $pre
  for dir in ${pre}*(/); do
    f_avif="${dir}.avif"; f_gif="${dir}.gif";
    
    if [[ ! -f "$f_avif" ]]; then avif "$dir"; fi
    mv $f_avif ${pre}/${f_avif}
    
    if [[ ! -f "$f_gif" ]]; then _giffle giffle "$dir"; fi
    mv $f_gif ${pre}/${f_gif}
    
    CH
  done
  CH
  for dir in ${pre}*(/); do rm -rf $dir done
  for f in ${pre}*.mp4(N); do rm $f; done
  echo "done"
}
func

for d in ${dirs[@]}(/); do _giffle giffle $d; done
